# =============================================================================
# Shared environment contract — defi-scripts and defi-mev
# Copy this file to .env, fill in values, never commit .env.
#
# The shared block below is byte-identical in both repos. Repo-specific
# sections follow it. All 44 mainnets are listed for both; each repo uses the
# subset in its own `src/config/chains.js`.
# =============================================================================

# --- Core -------------------------------------------------------------------
CHAIN=ethereum
# One Alchemy key fills every g.alchemy.com entry below.
ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY

# --- EVM mainnets -----------------------------------------------------------
# g.alchemy.com entries use ALCHEMY_API_KEY; the rest are public fallbacks.
# Ethereum
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Canonical Ethereum RPC. `ETH_RPC_URL` is a legacy alias still read by a few
# scripts; prefer ETHEREUM_RPC_URL and leave the alias unset.
# ETH_RPC_URL=

# Arbitrum
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Optimism
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Base
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Polygon zkEVM
POLYGONZKEVM_RPC_URL=https://zkevm-rpc.com
# BNB Chain
BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Gnosis
GNOSIS_RPC_URL=https://gnosis-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Avalanche C-Chain
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# Scroll
SCROLL_RPC_URL=https://scroll-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# zkSync Era
ZKSYNC_RPC_URL=https://mainnet.era.zksync.io
# Unichain
UNICHAIN_RPC_URL=https://unichain-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Monad
MONAD_RPC_URL=https://monad-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Arbitrum Nova
ARBNOVA_RPC_URL=https://nova.arbitrum.io/rpc
# Linea
LINEA_RPC_URL=https://rpc.linea.build
# Blast
BLAST_RPC_URL=https://rpc.blast.io
# Metis
METIS_RPC_URL=https://andromeda.metis.io/?owner=1088
# Celo
CELO_RPC_URL=https://forno.celo.org
# Mantle
MANTLE_RPC_URL=https://rpc.mantle.xyz
# Mode
MODE_RPC_URL=https://mainnet.mode.network
# Astar
ASTAR_RPC_URL=https://rpc.astar.network
# Ronin
RONIN_RPC_URL=https://api.roninchain.com/rpc
# Rootstock
ROOTSTOCK_RPC_URL=https://public-node.rsk.co
# Fraxtal
FRAX_RPC_URL=https://rpc.frax.com
# Sei
SEI_RPC_URL=https://evm-rpc.sei-apis.com
# Sonic
SONIC_RPC_URL=https://rpc.soniclabs.com
# Zora
ZORA_RPC_URL=https://rpc.zora.energy
# Shape
SHAPE_RPC_URL=https://mainnet.shape.network
# Soneium
SONEIUM_RPC_URL=https://rpc.soneium.org
# Ink
INK_RPC_URL=https://rpc-gel.inkonchain.com
# ApeChain
APECHAIN_RPC_URL=https://rpc.apechain.com/http
# Lens
LENS_RPC_URL=https://rpc.lens.xyz
# ZetaChain
ZETACHAIN_RPC_URL=https://zetachain-evm.blockpi.network/v1/rpc/public
# World Chain
WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
# Hyperliquid
HYPERLIQUID_RPC_URL=https://rpc.hyperliquid.xyz/evm
# Bob
BOB_RPC_URL=https://rpc.gobob.xyz
# Boba
BOBA_RPC_URL=https://mainnet.boba.network
# Flow
FLOW_RPC_URL=https://mainnet.evm.nodes.onflow.org
# opBNB
OPBNB_RPC_URL=https://opbnb-mainnet-rpc.bnbchain.org
# Story
STORY_RPC_URL=https://mainnet.storyrpc.io
# Abstract
ABSTRACT_RPC_URL=https://api.mainnet.abs.xyz
# Berachain
BERACHAIN_RPC_URL=https://rpc.berachain.com
# MegaETH
MEGAETH_RPC_URL=https://mainnet.megaeth.com/rpc
# Plasma
PLASMA_RPC_URL=https://rpc.plasma.to

# =============================================================================
# defi-scripts only
# =============================================================================

# --- Signing (swap examples; fork tests never need this) --------------------
PRIVATE_KEY=
WALLET_ADDRESS=

# --- Fork testing -----------------------------------------------------------
# Canonical block pin. FORK_BLOCK_NUMBER is a legacy alias read by two scripts.
# FORK_BLOCK=
# FORK_AMOUNT=0.1
# TEST_ADDRESS=

# --- Swap defaults ----------------------------------------------------------
DEFAULT_SLIPPAGE_BPS=50
TX_DEADLINE_SECONDS=1200
GAS_LIMIT_MULTIPLIER=1.2

# --- Fork / simulation knobs (optional) -------------------------------------
# DEX_VARIANT=uniswap-v3
# SIMULATE_V4=1
# SIMULATE_ONLY=true
# CHAINS=ethereum,arbitrum,base
# AAVE_SIM_ASSET=USDC
# AAVE_SIM_SUPPLY_UNITS=1000
# AAVE_LIQ_SIM_BLOCKS=2000
# AAVE_LIQ_MAX_BLOCKS=15000
# AAVE_LIQ_POLYGON_MAX_BLOCKS=4000
# LIDO_SUBMIT_WEI=10000000000000000
# MORPHO_MARKET_ID=0x...
# UNISWAPX_REPLAY_TX=0x...
# UNISWAPX_MAX_BLOCKS=200
# UNISWAPX_LOG_CHUNK=2000
# UNISWAPX_REPLAY_STRICT=0
# UNISWAPX_REACTOR=
# FORK_VALIDATE_ANVIL_READY_MS=120000
# FORK_VALIDATE_ANVIL_SETTLE_MS=4000
# FORK_VALIDATE_CHAIN_GAP_MS=8000
# FORK_VALIDATE_ANVIL_RETRIES=3
# FORK_VALIDATE_RETRY_WAIT_MS=10000
# FORK_VALIDATE_BASE_PORT=19850

# --- Signals / analytics (optional) -----------------------------------------
# COINGECKO_API_KEY=
# COINGECKO_API_TIER=demo
# COINGECKO_CACHE_TTL_MS=21600000
# NANSEN_API_KEY=
# NANSEN_PUBLIC=0
# NANSEN_CACHE_TTL_MS=43200000
# DEFILLAMA_TIMEOUT_MS=60000
# SIGNALS_CACHE_DIR=
# SIGNALS_OFF=1
# KINTSU_YIELDS_POOL_ID=
# STAKESTONE_YIELDS_POOL_ID=
# REYA_LLAMA_SLUG=reya-perps
# AMMALGAM_LLAMA_SLUG=

# --- Smokes (optional) ------------------------------------------------------
# SMOKE_SLUG=reya-perps
# SMOKE_MIN_TVL_USD=0

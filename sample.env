# RPC URLs for various chains
# Get free RPC URLs from: https://www.alchemy.com or https://infura.io

# Ethereum Mainnet
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Arbitrum
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optimism
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Base
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Staking monitors (optional): DefiLlama yields chart pool UUIDs — see yields.llama.fi
# KINTSU_YIELDS_POOL_ID=
# STAKESTONE_YIELDS_POOL_ID=

# Aave liquidation log scan (optional)
# AAVE_LIQ_MAX_BLOCKS=15000
# Polygon defaults to min(AAVE_LIQ_MAX_BLOCKS, 4000) — override with:
# AAVE_LIQ_POLYGON_MAX_BLOCKS=4000

# BSC (Alchemy doesn't support BSC, use public RPC)
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# zkSync Era (optional — Alchemy or https://mainnet.era.zksync.io)
# ZKSYNC_RPC_URL=https://mainnet.era.zksync.io

# Scroll (optional — e.g. https://rpc.scroll.io)
# SCROLL_RPC_URL=https://rpc.scroll.io

# Extended EVM chain (2026) — optional; Unichain + Uniswap V3/V4 in chains.js
# UNICHAIN_RPC_URL=https://mainnet.unichain.org

# Monad (Uniswap V3 in chains.js; WMON under COMMON_TOKENS.WETH)
# MONAD_RPC_URL=https://rpc.monad.xyz

# UniswapX fill replay (npm run simulate:uniswapx:fill)
# UNISWAPX_REPLAY_TX=0x...
# UNISWAPX_MAX_BLOCKS=200
# UNISWAPX_LOG_CHUNK=10
# UNISWAPX_REPLAY_STRICT=0

# Morpho Blue market read (npm run simulate:morpho:fork)
# MORPHO_MARKET_ID=0x...  # 32-byte uniqueKey; omit to use top market from API

# BlackRock BUIDL ERC-20 supply read (optional; DefiLlama: npm run analytics:buidl:markets)
# BUIDL_TOKEN_ADDRESS=0x7712c34205737192402172409a8f7ccef8aa2aec

# UniswapX Fill log scan (optional)
# UNISWAPX_REACTOR=
# UNISWAPX_MAX_BLOCKS=3000

# Multi-chain quote sweep (optional): comma-separated chain keys when SIMULATE_ONLY=true
# SIMULATE_CHAIN_KEYS=ethereum,arbitrum,base

# Gnosis
GNOSIS_RPC_URL=https://gnosis-mainnet.g.alchemy.com/v2/YOUR_GNOSIS_KEY

# ==================================================
# Token Swap Configuration (Required for swaps)
# ==================================================

# Private key for signing swap transactions
# WARNING: Keep this secret! Never commit to git!
# Generate a new wallet or use an existing one
PRIVATE_KEY=

# Default chain for swap operations
# Options: ethereum, arbitrum, optimism, base, polygon, bsc
CHAIN=ethereum

# Optional: Wallet address (for checking balances without private key)
# If not set, will derive from PRIVATE_KEY
WALLET_ADDRESS=

# ==================================================
# Fork Testing Configuration (Optional)
# ==================================================

# Test account address for fork testing
# Leave empty to use Anvil's default test account
TEST_ADDRESS=

# Fork block number (optional)
# Leave empty to fork from latest block
FORK_BLOCK_NUMBER=

# ==================================================
# Advanced Configuration (Optional)
# ==================================================

# Slippage tolerance in basis points (default: 50 = 0.5%)
DEFAULT_SLIPPAGE_BPS=50

# Transaction deadline in seconds (default: 1200 = 20 minutes)
TX_DEADLINE_SECONDS=1200

# Gas limit multiplier (default: 1.2 = 20% buffer)
GAS_LIMIT_MULTIPLIER=1.2

# ==================================================
# Week 4 analytics (optional)
# ==================================================
# DefiLlama protocol fetches (default 60000 ms)
# DEFILLAMA_TIMEOUT_MS=60000

# New-protocol monitors (DefiLlama slugs)
# REYA_LLAMA_SLUG=reya-perps
# AMMALGAM_LLAMA_SLUG=
# CURVY_LLAMA_SLUG=curves-protocol

# ==================================================
# Fork simulation & smokes (optional)
# ==================================================
# After: anvil --fork-url $ETHEREUM_RPC_URL --port 8545
# ETHEREUM_RPC_URL=http://127.0.0.1:8545
# FORK_BLOCK_NUMBER=  # optional; also used by scripts/startFork.js

# Multi-DEX runner: PROTOCOL=uniswap | sushiswap | curve | balancer
# DEX_VARIANT=uniswap-v2 | uniswap-v3 | uniswap-v4 | sushiswap-v2 | sushiswap-v3 | balancer-v2 | curve
# SIMULATE_V4=1       # include Uniswap V4 quotes (experimental)
# SIMULATE_ONLY=true  # quotes / read paths only

# Aave fork sim
# AAVE_SIM_ASSET=USDC
# AAVE_SIM_SUPPLY_UNITS=1000
# AAVE_LIQ_SIM_BLOCKS=2000

# Lido fork
# LIDO_SUBMIT_WEI=10000000000000000

# DefiLlama smoke (generic)
# SMOKE_SLUG=reya-perps
# SMOKE_MIN_TVL_USD=0

# Fork validation (npm run simulate:validate:forks)
# CHAINS=ethereum,arbitrum,base
# FORK_VALIDATE_ANVIL_READY_MS=120000
# FORK_VALIDATE_ANVIL_SETTLE_MS=4000
# FORK_VALIDATE_CHAIN_GAP_MS=8000
# FORK_VALIDATE_ANVIL_RETRIES=3
# FORK_VALIDATE_RETRY_WAIT_MS=10000
# FORK_VALIDATE_BASE_PORT=19850

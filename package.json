{
  "name": "defi-scripts",
  "version": "1.0.0",
  "description": "Uniswap analytics and swap scripts for DeFi/MEV builders and cross-chain analysis",
  "main": "src/index.js",
  "scripts": {
    "crosschain:balancer:tvl": "node src/crosschain/balancer/tvlTracker.js",
    "crosschain:balancer:volume": "node src/crosschain/balancer/volumeTracker.js",
    "crosschain:balancer:weekly:tvl": "node src/crosschain/balancer/weeklyTvlTracker.js",
    "crosschain:balancer:weekly:volume": "node src/crosschain/balancer/weeklyVolumeTracker.js",
    "crosschain:curve:tvl": "node src/crosschain/curve/tvlTracker.js",
    "crosschain:curve:volume": "node src/crosschain/curve/volumeTracker.js",
    "crosschain:curve:weekly:tvl": "node src/crosschain/curve/weeklyTvlTracker.js",
    "crosschain:curve:weekly:volume": "node src/crosschain/curve/weeklyVolumeTracker.js",
    "crosschain:sushiswap:tvl": "node src/crosschain/sushiswap/tvlTracker.js",
    "crosschain:sushiswap:volume": "node src/crosschain/sushiswap/volumeTracker.js",
    "crosschain:sushiswap:weekly:tvl": "node src/crosschain/sushiswap/weeklyTvlTracker.js",
    "crosschain:sushiswap:weekly:volume": "node src/crosschain/sushiswap/weeklyVolumeTracker.js",
    "crosschain:uniswap:tvl": "node src/crosschain/uniswap/tvlTracker.js",
    "crosschain:uniswap:volume": "node src/crosschain/uniswap/volumeTracker.js",
    "crosschain:uniswap:liquidity": "node src/crosschain/uniswap/liquidityTracker.js",
    "crosschain:uniswap:weekly:tvl": "node src/crosschain/uniswap/weeklyTvlTracker.js",
    "crosschain:uniswap:weekly:volume": "node src/crosschain/uniswap/weeklyVolumeTracker.js",
    "crosschain:uniswap:weekly:liquidity": "node src/crosschain/uniswap/weeklyLiquidityTracker.js",
    "analytics:aave:liquidations": "node src/analytics/protocols/aave/liquidationRiskMonitor.js",
    "analytics:aave:markets": "node src/analytics/protocols/aave/marketMonitor.js",
    "analytics:aave:versions": "node src/analytics/protocols/aave/versionComparison.js",
    "analytics:ammalgam:hybrid": "node src/analytics/protocols/ammalgam/hybridMonitor.js",
    "analytics:amm:aggregate": "node src/analytics/aggregators/allAmmDexAggregator.js",
    "analytics:balancer:pools": "node src/analytics/protocols/balancer/poolMonitor.js",
    "analytics:curve:pools": "node src/analytics/protocols/curve/poolMonitor.js",
    "analytics:curvy:aggregator": "node src/analytics/protocols/curvy/zkAggregatorMonitor.js",
    "analytics:dex:prices": "node src/analytics/aggregators/dexPriceAggregator.js",
    "analytics:kintsu:staking": "node src/analytics/protocols/kintsu/stakingMonitor.js",
    "analytics:lending:aggregate": "node src/analytics/aggregators/allLendingAggregator.js",
    "analytics:lending:rates": "node src/analytics/aggregators/lendingRateAggregator.js",
    "analytics:lido:staking": "node src/analytics/protocols/lido/stakingMonitor.js",
    "analytics:morpho:optimizer": "node src/analytics/protocols/morpho/morphoOptimizerMonitor.js",
    "analytics:reya:dex": "node src/analytics/protocols/reya/dexMonitor.js",
    "analytics:stakestone:staking": "node src/analytics/protocols/stakestone/stakingMonitor.js",
    "analytics:staking:aggregate": "node src/analytics/aggregators/allStakingAggregator.js",
    "analytics:staking:compare": "node src/analytics/aggregators/stakingYieldAggregator.js",
    "analytics:sushiswap:pools": "node src/analytics/protocols/sushiswap/poolMonitor.js",
    "analytics:uniswap:prices": "node src/analytics/protocols/uniswap/priceMonitor.js",
    "analytics:weekly:blocks": "node src/analytics/weeklyBlockAnalysis.js",
    "simulate:quote": "SIMULATE_ONLY=true node src/simulation/simulateSwap.js",
    "simulate:swap": "node src/simulation/simulateSwap.js",
    "simulate:multi:quote": "SIMULATE_ONLY=true node src/simulation/simulateMultiProtocol.js",
    "simulate:multi": "node src/simulation/simulateMultiProtocol.js",
    "simulate:dex:balancer": "DEX_VARIANT=balancer-v2 SIMULATE_ONLY=true node src/simulation/simulateMultiProtocol.js",
    "simulate:dex:curve": "DEX_VARIANT=curve SIMULATE_ONLY=true node src/simulation/simulateMultiProtocol.js",
    "simulate:dex:sushiswap:v2": "DEX_VARIANT=sushiswap-v2 SIMULATE_ONLY=true node src/simulation/simulateMultiProtocol.js",
    "simulate:dex:sushiswap:v3": "DEX_VARIANT=sushiswap-v3 SIMULATE_ONLY=true node src/simulation/simulateMultiProtocol.js",
    "simulate:dex:uniswap:v2": "DEX_VARIANT=uniswap-v2 SIMULATE_ONLY=true node src/simulation/simulateMultiProtocol.js",
    "simulate:dex:uniswap:v3": "DEX_VARIANT=uniswap-v3 SIMULATE_ONLY=true node src/simulation/simulateMultiProtocol.js",
    "simulate:dex:uniswap:v4": "SIMULATE_V4=1 DEX_VARIANT=uniswap-v4 SIMULATE_ONLY=true node src/simulation/simulateMultiProtocol.js",
    "simulate:aave:liquidations": "node src/simulation/lending/simulateAaveLiquidationsFork.js",
    "simulate:aave:markets": "SIMULATE_ONLY=true node src/simulation/lending/simulateAaveV3Fork.js",
    "simulate:aave:versions": "node src/simulation/lending/simulateAaveVersionsFork.js",
    "simulate:aave:v3:fork": "node src/simulation/lending/simulateAaveV3Fork.js",
    "simulate:lending:aggregate:smoke": "node src/simulation/api/smokeLendingLlamaAggregate.js",
    "simulate:lending:rates:smoke": "node src/simulation/lending/simulateLendingRatesSmoke.js",
    "simulate:lido:fork": "node src/simulation/staking/simulateLidoFork.js",
    "simulate:lido:read": "SIMULATE_ONLY=true node src/simulation/staking/simulateLidoFork.js",
    "simulate:kintsu:smoke": "node src/simulation/staking/kintsuSmoke.js",
    "simulate:stakestone:smoke": "node src/simulation/staking/stakestoneSmoke.js",
    "simulate:staking:compare:smoke": "node src/simulation/staking/simulateStakingCompareSmoke.js",
    "simulate:amm:aggregate:smoke": "node src/simulation/api/smokeAmmLlamaAggregate.js",
    "simulate:ammalgam:smoke": "SMOKE_ALLOW_NOT_LISTED=1 SMOKE_SLUG=ammalgam node src/simulation/api/smokeDefiLlamaProtocol.js",
    "simulate:curvy:smoke": "SMOKE_SLUG=curves-protocol node src/simulation/api/smokeDefiLlamaProtocol.js",
    "simulate:morpho:smoke": "node src/simulation/api/smokeMorphoGraphql.js",
    "simulate:reya:smoke": "SMOKE_SLUG=reya-perps node src/simulation/api/smokeDefiLlamaProtocol.js",
    "simulate:weekly:blocks": "node src/analytics/weeklyBlockAnalysis.js",
    "simulate:validate:forks": "node scripts/validateForkSimulations.js",
    "test:pairs": "node src/simulation/testAllPairs.js",
    "test:pairs:all": "GROUP=all node src/simulation/testAllPairs.js",
    "swap:autoroute": "node src/examples/dexAggregatorExample.js",
    "swap:balancer": "node src/examples/balancerSwapExample.js",
    "swap:check": "node src/examples/checkWalletExample.js",
    "swap:crosschain": "node src/examples/crossChainSwapComparison.js",
    "swap:curve": "node src/examples/curveSwapExample.js",
    "swap:example": "node src/examples/swapExample.js",
    "swap:sushiswap": "node src/examples/sushiswapSwapExample.js",
    "swap:uniswap:v2": "node src/examples/v2SwapExample.js",
    "swap:uniswap:v3": "node src/examples/v3SwapExample.js",
    "swap:uniswap:v4": "node src/examples/v4SwapExample.js",
    "lint:fix": "eslint . --ignore-path .eslintignore --ext .js,.sol --fix --quiet",
    "prettier": "prettier --write './**/*.{js,json,yaml,yml,sol}'"
  },
  "keywords": [
    "uniswap",
    "defi",
    "mev",
    "cross-chain",
    "analytics",
    "swap",
    "uniswap-v2",
    "uniswap-v3",
    "uniswap-v4"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xjjda22/defi-scripts.git"
  },
  "bugs": {
    "url": "https://github.com/xjjda22/defi-scripts/issues"
  },
  "homepage": "https://github.com/xjjda22/defi-scripts#readme",
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "ora": "^9.1.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.2"
  }
}
